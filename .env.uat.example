# UAT server settings. Copy to .env on the server (uat.sh install does it once) and
# replace UAT_HOST everywhere with the server's address as testers type it in the
# browser — a DNS name (uat.example.org) or an IP address (10.0.0.25).
# Never commit the real .env.

# Postgres — change the password before the first start (it is fixed into the database then).
POSTGRES_USER=pensionz
POSTGRES_PASSWORD=change-me-uat-db-password
POSTGRES_DB=pensionz
DATABASE_URL=postgresql+psycopg2://pensionz:change-me-uat-db-password@db:5432/pensionz

# MinIO (KYC documents, proof of payment)
MINIO_ROOT_USER=pensionz
MINIO_ROOT_PASSWORD=change-me-uat-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://UAT_HOST:9002
MINIO_BUCKET=pensionz-documents

# Auth — a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend: the address testers open, so the browser may call the API and email links work.
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://UAT_HOST:5178
APP_BASE_URL=http://UAT_HOST:5178

# Email: leave unset to catch every email in Mailpit (http://UAT_HOST:8026) — testers read
# sign-in codes there. Set these only to send real email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.org

# Frontend: where the browser finds the API, and the host name Vite should answer to.
VITE_API_BASE_URL=http://UAT_HOST:8002/api/v1
VITE_ALLOWED_HOSTS=UAT_HOST

# Password given to every seeded UAT login (app.seed_uat). Change it if the server is reachable
# beyond the test team.
SEED_PASSWORD=Pensionz2026
