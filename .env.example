# Copy to .env and adjust for local dev. Never commit the real .env.

# Postgres (host port 5433)
POSTGRES_USER=pensionz
POSTGRES_PASSWORD=pensionz_dev_password
POSTGRES_DB=pensionz
DATABASE_URL=postgresql+psycopg2://pensionz:pensionz_dev_password@db:5432/pensionz

# MinIO (KYC documents, generated statements/vouchers). Console http://localhost:9003
MINIO_ROOT_USER=pensionz
MINIO_ROOT_PASSWORD=pensionz_dev_password
MINIO_ENDPOINT=http://minio:9000
# Presigned URLs are opened by the browser, so they need the host-facing port.
MINIO_PUBLIC_ENDPOINT=http://localhost:9002
MINIO_BUCKET=pensionz-documents

# Auth
JWT_SECRET_KEY=dev-only-change-me-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5178

# Email. Unset = Mailpit dev catcher (read mail at http://localhost:8026).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@pensionz.dev
APP_BASE_URL=http://localhost:5178

# Frontend
VITE_API_BASE_URL=http://localhost:8002/api/v1
